# Fork-local build identity. Keep local app ids, publish targets and signing
# configuration out of Git. Packaging does not load these files automatically;
# an explicit --config argument and artifact verification are required.
/electron-builder.local.yml
/apps/desktop/electron-builder.local.yml
/apps/desktop/release-local/
*.local.env
.env.local
